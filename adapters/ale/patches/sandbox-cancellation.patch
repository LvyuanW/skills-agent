+            deployer_cls=self.fixture.Deployer,
+            prompt="unused",
+            timeout_s=timeout_s,
+        )
+
+    async def assert_stopped(self):
+        before = (self.wd / "heartbeat").read_text()
+        await asyncio.sleep(0.15)
+        self.assertEqual(before, (self.wd / "heartbeat").read_text())
+        pid = int((self.wd / "writer.pid").read_text())
+        path = Path(f"/proc/{pid}/stat")
