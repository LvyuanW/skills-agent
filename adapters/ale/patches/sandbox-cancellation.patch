+
+    async def test_outer_wait_for_stops_detached_writer_before_return(self):
+        with self.assertRaises(TimeoutError):
+            await asyncio.wait_for(self.run_agent(), timeout=1.0)
+        await self.assert_stopped()
+
+    async def test_cancel_during_spawn_waits_for_late_pid(self):
+        self.sb.pid_delay = 0.5
+        task = asyncio.create_task(self.run_agent())
+        await self.wait_for_file("heartbeat")
+        self.assertFalse((self.wd / "_pid").exists())
+        task.cancel()
+        with self.assertRaises(asyncio.CancelledError):
+            await task
+        self.assertTrue((self.wd / "_pid").exists())
+        await self.assert_stopped()
+
+    async def test_cancel_before_remote_launcher_executes_prevents_late_start(self):
+        self.sb.spawn_delay = 0.5
+        task = asyncio.create_task(self.run_agent())
+        await self.sb.spawn_entered.wait()
+        task.cancel()
+        with self.assertRaises(asyncio.CancelledError):
+            await task
+        await asyncio.gather(*self.sb.pending)
+        self.assertFalse((self.wd / "writer.pid").exists())
+        self.assertFalse((self.wd / "_pid").exists())
+
+    async def test_repeated_cancel_does_not_interrupt_cleanup(self):
+        task = asyncio.create_task(self.run_agent())
+        await self.wait_for_file("heartbeat")
+        task.cancel()
+        await self.sb.cleanup_entered.wait()
+        task.cancel()
+        with self.assertRaises(asyncio.CancelledError):
+            await task
+        await self.assert_stopped()
+
+    async def test_cancel_during_setup_does_not_kill_stale_pid(self):
+        self.wd.mkdir(parents=True)
+        (self.wd / "_pid").write_text(str(os.getpid()))
+        entered = asyncio.Event()
+
+        async def delayed_ship(_):
+            entered.set()
+            await asyncio.sleep(3600)
+
+        with patch.object(SandboxExecutor, "_ship_ale_subtree", side_effect=delayed_ship):
+            task = asyncio.create_task(self.run_agent())
+            await entered.wait()
+            task.cancel()
+            with self.assertRaises(asyncio.CancelledError):
+                await task
+        self.assertFalse(self.sb.cleanup_entered.is_set())
+        (self.wd / "_pid").unlink()
+
+    async def test_normal_completion_preserves_task_service(self):
+        self.executor.config.completed = True
+        result = await self.run_agent()
+        self.assertEqual(result.status, "completed")
+        await self.wait_for_file("heartbeat")
+        before = (self.wd / "heartbeat").read_text()
+        await asyncio.sleep(0.15)
+        self.assertNotEqual(before, (self.wd / "heartbeat").read_text())
+        self.assertFalse(self.sb.cleanup_entered.is_set())
+
+    async def test_poll_exception_stops_writer_before_propagating(self):
+        original_exists = self.sb.exists
