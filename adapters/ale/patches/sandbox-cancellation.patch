new file mode 100644
index 0000000..fdeaf6c
--- /dev/null
+++ b/ale_run/executors/_sandbox_stop.py
@@ -0,0 +1,90 @@
+"""Cancel one Linux sandbox attempt and confirm its processes have stopped."""
+
+from __future__ import annotations
+
+import fcntl
+import os
+import signal
+import sys
+import time
+from pathlib import Path
+
+
+def _processes(token: str, known: dict[int, str]) -> dict[int, str]:
+    marker = f"ALE_SANDBOX_RUN_ID={token}".encode()
+    records: dict[int, tuple[int, str]] = {}
+    selected: dict[int, str] = {}
+    for directory in Path("/proc").iterdir():
+        if not directory.name.isdigit():
+            continue
+        pid = int(directory.name)
+        if pid == os.getpid():
+            continue
+        try:
+            fields = (directory / "stat").read_text().rsplit(")", 1)[1].split()
+            if fields[0] == "Z":
+                continue
+            parent, start = int(fields[1]), fields[19]
+            records[pid] = (parent, start)
+            if known.get(pid) == start or marker in (directory / "environ").read_bytes().split(
+                b"\0"
+            ):
+                selected[pid] = start
+        except (FileNotFoundError, ProcessLookupError, PermissionError):
+            continue
+    # Also retain descendants that deliberately replaced their environment.
+    while True:
+        children = {
+            pid: start
+            for pid, (parent, start) in records.items()
+            if parent in selected and pid not in selected
+        }
+        if not children:
+            break
+        selected.update(children)
+    return selected
+
+
+def _signal(processes: dict[int, str], sig: signal.Signals) -> None:
+    for pid, start in processes.items():
+        try:
+            fields = Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()
+            if fields[19] == start and fields[0] != "Z":
+                os.kill(pid, sig)
+        except (FileNotFoundError, ProcessLookupError):
+            continue
+
+
+def stop(token: str, cancel_marker: Path, *, grace_s: float = 8.0) -> None:
+    """Prevent late launch and terminate only processes owned by this attempt."""
+    # The launcher holds the same lock until its child PID is written. A
+    # cancelled HTTP request may still launch later, so the marker is persistent.
+    with Path(f"{cancel_marker}.lock").open("a") as lock:
+        fcntl.flock(lock, fcntl.LOCK_EX)
+        cancel_marker.write_text("cancelled\n")
+    known: dict[int, str] = {}
+    termed: dict[int, str] = {}
+    deadline = time.monotonic() + grace_s
+    kill_deadline = deadline + 3.0
+    while True:
+        active = _processes(token, known)
+        if not active:
+            return
+        known.update(active)
+        if time.monotonic() < deadline:
+            new = {pid: start for pid, start in active.items() if termed.get(pid) != start}
+            _signal(new, signal.SIGTERM)
+            termed.update(new)
+        else:
+            # Freeze before rediscovery so a forking process cannot outrun KILL.
+            _signal(active, signal.SIGSTOP)
+            active = _processes(token, known)
+            known.update(active)
+            _signal(active, signal.SIGKILL)
+        if time.monotonic() >= kill_deadline:
+            raise RuntimeError(f"sandbox processes did not stop: {sorted(active)}")
+        time.sleep(0.05)
+
+
+if __name__ == "__main__":
+    stop(sys.argv[1], Path(sys.argv[2]))
