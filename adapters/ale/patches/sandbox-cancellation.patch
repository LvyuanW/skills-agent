+"""Real Linux process regressions. No model API, cloud VM, or CUA server needed."""
+
+from __future__ import annotations
+
+import asyncio
+import importlib
+import os
+import signal
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import AsyncMock, MagicMock, patch
+
+from ale_run.base_interface import SandboxHandle
+from ale_run.executors.sandbox import SandboxCleanupError, SandboxExecutor
+
+FIXTURE = r"""
+import asyncio
+from dataclasses import dataclass
+from pathlib import Path
+import subprocess
+import sys
+from ale_run.base_interface import AgentRunResult
+
+@dataclass
+class Config:
+    model: str = "fixture"
+    completed: bool = False
+
+class Deployer:
+    def __init__(self, executor):
+        self.executor = executor
+
+    async def install(self):
+        pass
+
+    async def launch(self, prompt):
+        root = Path(self.executor.work_dir)
+        writer = "import signal,time; from pathlib import Path; signal.signal(signal.SIGTERM, signal.SIG_IGN); p=Path(" + repr(str(root / "heartbeat")) + "); " + "exec('while True:\\n p.write_text(str(time.time()))\\n time.sleep(0.02)')"
+        process = subprocess.Popen([sys.executable, "-c", writer], start_new_session=True)
+        (root / "writer.pid").write_text(str(process.pid))
+        if self.executor.config.completed:
+            return AgentRunResult(status="completed")
+        await asyncio.sleep(3600)
+"""
+
+
+class LocalSandbox(SandboxHandle):
+    def __init__(self, root: Path):
+        super().__init__(
+            id="cancellation-test",
+            endpoint="http://unused",
+            os="linux",
+            work_dir_base=str(root / ".ale"),
+            task_data_root=str(root),
+            node="node",
+            python=sys.executable,
+            mcp_server_dir=str(root),
+        )
+        self.spawn_entered = asyncio.Event()
+        self.spawn_delay = 0.0
+        self.pid_delay = 0.0
+        self.cleanup_entered = asyncio.Event()
+        self.fail_cleanup = False
+        self.pending: list[asyncio.Task] = []
+
+    async def run_command(self, command, *, timeout=60):
+        async def execute():
+            if "bash " in command and "_launcher.sh" in command:
+                self.spawn_entered.set()
+                await asyncio.sleep(self.spawn_delay)
+            if "_sandbox_stop.py" in command:
+                self.cleanup_entered.set()
+                if self.fail_cleanup:
+                    return subprocess.CompletedProcess(command, 1, "", "test transport failure")
+            process = await asyncio.create_subprocess_shell(
+                command,
+                stdout=asyncio.subprocess.PIPE,
+                stderr=asyncio.subprocess.PIPE,
+            )
+            stdout, stderr = await asyncio.wait_for(process.communicate(), timeout)
+            return subprocess.CompletedProcess(
+                command,
+                process.returncode,
+                stdout.decode(),
+                stderr.decode(),
+            )
+
+        task = asyncio.create_task(execute())
+        self.pending.append(task)
+        # SandboxHandle uses to_thread: cancelling the await does not cancel the RPC.
+        return await asyncio.shield(task)
+
+    async def mkdir(self, path):
+        Path(path).mkdir(parents=True, exist_ok=True)
+
+    async def rm(self, paths):
+        for path in paths:
+            Path(path).unlink(missing_ok=True)
+
+    async def write_file(self, path, content):
+        if path.endswith("_launcher.sh") and self.pid_delay:
+            content = content.replace("CHILD=$!\n", f"CHILD=$!\nsleep {self.pid_delay}\n")
+        Path(path).write_bytes(content if isinstance(content, bytes) else content.encode())
+
+    async def read_text(self, path):
+        return Path(path).read_text()
+
+    async def exists(self, path):
+        return Path(path).exists()
+
+
+@unittest.skipUnless(sys.platform == "linux", "Linux process lifecycle regression")
+class CancellationTests(unittest.IsolatedAsyncioTestCase):
+    async def asyncSetUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.root = Path(self.temp.name)
+        source = self.root / ".ale-src"
+        source.mkdir()
+        (source / "ale_run").symlink_to(Path(__file__).resolve().parents[2] / "ale_run")
+        (source / "fixture_deployer.py").write_text(FIXTURE)
+        sys.path.insert(0, str(source))
+        self.fixture = importlib.import_module("fixture_deployer")
+        self.sb = LocalSandbox(self.root)
+        self.wd = self.root / ".ale" / "run"
+        self.executor = SandboxExecutor(
+            config=self.fixture.Config(),
+            sandbox=self.sb,
+            work_dir=str(self.wd),
